# Ce fichier ne doit contenir aucun mot de passe, token ni clé d’API.
# Les secrets optionnels sont chargés depuis /etc/asmira/asmira.env.

[targets]
domains =
	example.org
	example.net

[discovery]
sources = shodan-ctl,subfinder,shodan-dns,certspotter
enable_amass = false
# Délai propre à Amass par domaine, en secondes ; vide = source_timeout.
amass_timeout =
# Brute-force DNS et tentative de transfert de zone (AXFR) avec dnsx : actif,
# réservé aux domaines autorisés. La liste de mots est obligatoire si activé
# (ex. SecLists Discovery/DNS/subdomains-top1million-5000.txt).
enable_dnsx = false
dnsx_wordlist =
# Adresses IP séparées par des virgules ; vide = résolveurs du système.
dnsx_resolvers =
dnsx_rate_limit = 100
collector_workers = 4
dns_workers = 20
source_timeout = 600
dns_timeout = 4
wildcard_samples = 2
max_pages = 1000
shodan_history = false

[active_scan]
enabled = true
# Cette valeur confirme durablement que tous les domaines ci-dessus sont
# autorisés pour la reconnaissance active exécutée par le timer.
authorized = false
endpoint_workers = 4
subprocess_budget = 16
checkpoint_every = 25
# Laisser vide en production. Utiliser 100 pour le premier pilote.
max_endpoints =
screenshots = false
graphs = false
xlsx = false

[storage]
runs_dir = /var/lib/asmira/runs
export_dir = /var/lib/asmira/export
pictures_dir = /var/lib/asmira/pictures
# État persistant des collecteurs incrémentaux (curseur Cert Spotter).
state_dir = /var/lib/asmira/state
# Rétention locale des exports déjà destinés à Elastic Agent.
retention_days = 14

[report]
# Un bilan HTML autonome est écrit après chaque run dans
# runs/<run-id>/<run-id>_report.html. Avec email = true, un e-mail de synthèse
# le porte en pièce jointe vers email_to (adresses séparées par des virgules).
# Le bilan est sensible.
email = false
email_to =
email_from =
# Relais SMTP : par défaut le MTA local, sans authentification.
smtp_host = localhost
smtp_port = 25
smtp_starttls = false
# Avec un compte, le mot de passe est lu dans ASMIRA_SMTP_PASSWORD (asmira.env).
smtp_username =
# Nombre maximal de lignes par liste détaillée du bilan.
max_items = 50

[tools]
# Laisser vide pour utiliser la détection via PATH.
subfinder =
amass =
dnsx =
nmap =
openssl =
netcat =
