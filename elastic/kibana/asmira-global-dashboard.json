    {
      "type": "vis",
      "config": {
        "type": "data_table",
        "title": "Constats ouverts les plus anciens",
        "data_source": {
          "type": "esql",
          "query": "FROM asmira-exposure-current | WHERE asmira.exposure.tls.findings_since IS NOT NULL | MV_EXPAND asmira.exposure.tls.findings_since | DISSECT asmira.exposure.tls.findings_since \"%{Constat}@%{Depuis}\" | WHERE Constat != \"HSTS_MISSING\" | EVAL Jours = DATE_DIFF(\"day\", TO_DATETIME(Depuis), NOW()) | RENAME server.domain AS FQDN, asmira.exposure.tls.grade AS Note | SORT Jours DESC, FQDN ASC | KEEP FQDN, Note, Constat, Depuis, Jours | LIMIT 1000"
        },
        "rows": [
          {
            "column": "FQDN"
          },
          {
            "column": "Note"
          },
