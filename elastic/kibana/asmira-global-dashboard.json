        "data_source": {
          "type": "esql",
          "query": "FROM asmira-exposure-current | WHERE asmira.exposure.tls.pqc_kex_status IS NOT NULL | EVAL `Échange de clés` = CASE(asmira.exposure.tls.pqc_kex_status == \"hybrid\", \"Hybride ML-KEM\", asmira.exposure.tls.pqc_kex_status == \"partial\", \"ML-KEM sur une partie des IP\", asmira.exposure.tls.pqc_kex_status == \"classical\", \"TLS 1.3 sans ML-KEM\", asmira.exposure.tls.pqc_kex_status == \"no_tls13\", \"Sans TLS 1.3\", \"Indéterminé\") | STATS FQDN = COUNT(*) BY `Échange de clés`"
        },
        "metrics": [
          {
            "column": "FQDN"
          }
        ],
        "group_by": [
          {
            "column": "Échange de clés"
          }
