{
  "source": {
    "index": ["logs-asmira.exposure-*"]
  },
  "latest": {
    "unique_key": ["asmira.asset.id"],
    "sort": "@timestamp"
  },
  "frequency": "5m",
  "dest": {
    "index": "asmira-exposure-latest"
  },
  "sync": {
    "time": {
      "field": "@timestamp",
      "delay": "60s"
    }
  },
  "retention_policy": {
    "time": {
      "field": "@timestamp",
      "max_age": "10d"
    }
  },
  "description": "Dernière observation active par couple FQDN/IP Asmira"
}
